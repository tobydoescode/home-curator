{
  "name": "Home Curator (Home Assistant Supervisor)",
  "image": "ghcr.io/home-assistant/devcontainer:2-addons",

  // Supervisor needs to drive Docker and manage cgroups.
  "runArgs": ["-e", "GIT_EDITOR=code --wait", "--privileged"],
  "containerEnv": { "WORKSPACE_DIRECTORY": "${containerWorkspaceFolder}" },

  // The mount path is load-bearing: Supervisor discovers local add-ons by
  // scanning /mnt/supervisor/addons/local. Mounting the repo anywhere else
  // means it never appears in the add-on store.
  "workspaceMount": "source=${localWorkspaceFolder},target=/mnt/supervisor/addons/local/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/mnt/supervisor/addons/local/${localWorkspaceFolderBasename}",

  "postStartCommand": "bash devcontainer_bootstrap",

  // 7123 → Home Assistant, 7357 → Supervisor's observer.
  "appPort": ["7123:8123", "7357:4357"],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
